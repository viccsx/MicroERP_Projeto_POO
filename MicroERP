#valida qualquer reposta que contenha vírgulas, para que o programa possa rodar
def ler_numero(mensagem):
    while True:
        numero = input(mensagem).strip().replace(',', '.')
        partes = numero.split('.')

        if len(partes) <= 2 and all(parte.isdigit() for parte in partes) and all(partes):
            return float(numero)

        print("Resposta inválida! Digite um número correto.")

#criar classe empresa
class Empresa:
    def __init__(self, nome, cnpj, tel):
        self.__nome = nome
        self.__cnpj = cnpj
        self.__tel = tel
        self.__produto = []
        self.__cliente = []

    @property
    def nome(self):
        return self.__nome

    @property
    def cnpj(self):
        return self.__cnpj

    @property
    def tel(self):
        return self.__tel

    @property
    def produtos(self):
        return self.__produto

    @property
    def clientes(self):
        return self.__cliente

    @nome.setter
    def nome(self, n):
        self.__nome = n

    @cnpj.setter
    def cnpj(self, c):
        self.__cnpj = c

    @tel.setter
    def tel(self, t):
        self.__tel = t

#listas pra controlar produtos e clientes
    def ad_produto(self, produto):
        self.__produto.append(produto)

    def ad_cliente(self, cliente):
        self.__cliente.append(cliente)

    def __repr__(self):
        return f'Empresa: {self.__nome}. CNPJ: {self.__cnpj}. Telefone: {self.__tel} .' 


#Questão 01, classe produto
class Produto:
    def __init__(self, n, pc, pv, qtd_e):
        self.__nome = n
        self.__p_de_custo = pc
        self.__p_de_venda = pv
        self.__qtd_em_estoque = qtd_e

    #geters e setters
    @property
    def nome(self):
        return self.__nome

    @property
    def p_de_custo(self):
        return self.__p_de_custo

    @property
    def p_de_venda(self):
        return self.__p_de_venda

    @property
    def qtd_em_estoque(self):
        return self.__qtd_em_estoque

    @nome.setter
    def nome(self, no):
        self.__nome = no

    @p_de_custo.setter
    def p_de_custo(self, p):
        self.__p_de_custo = p

    @p_de_venda.setter
    def p_de_venda(self, v):
        self.__p_de_venda = v

    @qtd_em_estoque.setter
    def qtd_em_estoque(self, es):
        self.__qtd_em_estoque = es

    #Parte do relatório de produtos
    def __repr__(self):
        return f'Produto: {self.__nome}, Preço de Custo: R${self.__p_de_custo:.2f}, Preço de Venda: R${self.__p_de_venda:.2f}, Quantidade em Estoque: {self.__qtd_em_estoque}'


