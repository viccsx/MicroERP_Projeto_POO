        self.__cpf = cpf
        self.__telefone = tel
        self.__saldo_devedor = 0

    #getters e setters
    @property
    def nome(self):
        return self.__nome

    @property
    def cpf(self):
        return self.__cpf

    @property
    def telefone(self):
        return self.__telefone

    @property
    def saldo_devedor(self):
     return self.__saldo_devedor

    @nome.setter
    def nome(self, no):
        self.__nome = no

    @cpf.setter
    def cpf(self, c):
        self.__cpf = c

    @telefone.setter
    def telefone(self, t):
