#classe vendas
class Vendas:
  def __init__(self,produto,quantidade,valor_de_venda,cliente,forma_de_pagamento,lucro):
    self.__produto=produto
    self.__quantidade=quantidade
    self.__valor_de_venda=valor_de_venda
    self.__cliente=cliente
    self.__forma_de_pagamento=forma_de_pagamento
    self.__lucro=lucro

  @property
  def produto(self):
    return self.__produto

  @property
  def quantidade (self):
    return self.__quantidade

  @property
  def valor_de_venda(self):
    return  self.__valor_de_venda

  @property
  def cliente (self):
    return self.__cliente

  @property
  def forma_de_pagamento(self):
    return self.__forma_de_pagamento

  @property
  def lucro(self):
    return self.__lucro

  @produto.setter
  def produto (self,p):
    self.__produto=p

  @quantidade.setter
  def quantidade(self,q):
    self.__quantidade=q

  @valor_de_venda.setter
  def valor_de_venda (self,v):
    self.__valor_de_venda=v

  @cliente.setter
  def cliente(self,c):
    self.__cliente=c

  @forma_de_pagamento.setter
  def forma_de_pagamento(self,f):
    self.__forma_de_pagamento=f

  def __repr__ (self):
    return f"Produto: {self.produto.nome}, quantidade: {self.quantidade}, valor de venda: {self.valor_de_venda}, cliente: {self.cliente}, forma de pagamento: {self.forma_de_pagamento}, lucro: {self.lucro}."


#criar formas de pagamento
class FormaPagamento(ABC):
 @abstractmethod
 def processar_pagamento(self, valor):
  ...

class Pix(FormaPagamento):
 def processar_pagamento(self, valor):
  print(f'O pagamento de R${valor:.2f} foi realizado via Pix.')
  return True

class Especie(FormaPagamento):
  #verifica se o usuário digitar um valor insuficiente
    def processar_pagamento(self, valor):
      v = 0

      while v < valor:
          v = ler_numero('Digite o valor pago pelo cliente: ')

          if v < valor:
              print('Valor insuficiente. Digite o valor novamente.')

      troco = v - valor
      print(f'Valor Pago, troco: R${troco:.2f}')
      return True

class Fiado(FormaPagamento):
 def processar_pagamento(self, valor, empresa):
    while True:
        nome = input('Digite o nome do cliente: ')
        cliente_encontrado = None

        for c in empresa.clientes:
            if c.nome.lower() == nome.lower():
                cliente_encontrado = c
                break

        if cliente_encontrado is not None:
            cliente_encontrado.adicionar_divida(valor)
            self.cliente_encontrado = cliente_encontrado
            print(f'Venda de R${valor:.2f} registrada no saldo devedor do cliente.')
            return True

        print('Cliente não encontrado. Digite novamente.')


